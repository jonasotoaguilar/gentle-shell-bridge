{
  "name": "gentle-shell-bridge",
  "version": "0.3.0",
  "description": "Shared provider bus for gentle-shell's /gentle:customize settings rows: plugins register rows, the bridge owns the single interception layer.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "gentle-shell",
    "gentle-ai",
    "extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonasotoaguilar/gentle-shell-bridge.git"
  },
  "files": [
    "src",
    "docs/contract.md",
    "docs/state.md",
    "docs/architecture.md",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
